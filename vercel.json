{
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/([^/]+)/([^/]+)/index[^/]+\\.html$", "dest": "/template/article.html" },

    { "src": "^/resources/ico/c/(.*)$", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/(.*)\\.svg$", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/js/bundle\\.js$", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }, "continue": true },
    { "src": "^/css/bundle\\.css$", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/resources/ico-sprite\\.svg$", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },

    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/err/http/404.html" }
  ]
}